# ACES Docker Environment Variable Reference

# ----------------------------------------------------
# 1. DEFAULT: MongoDB Atlas Connection (Production / Cloud DB)
# ----------------------------------------------------
# MONGO_URI=mongodb+srv://<username>:<password>@cluster00.vujlpwx.mongodb.net/aces?retryWrites=true&w=majority

# ----------------------------------------------------
# 2. OPTIONAL: Local MongoDB Docker Service Connection
# (To use local MongoDB, run: docker compose --profile with-local-db up --build)
# ----------------------------------------------------
# MONGO_URI=mongodb://mongodb:27017/aces

# General Backend Settings
PORT=5000
NODE_ENV=development
JWT_SECRET=aces_super_secret_jwt_key_2026

# Frontend Settings (Passed automatically by docker-compose)
VITE_PROXY_TARGET=http://backend:5000
